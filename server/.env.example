# API server
PORT=4000
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety
JWT_SECRET=change-me-to-a-long-random-string
# Time zone used to decide what "today" is (no future dates allowed)
APP_TIMEZONE=Asia/Kolkata
# Origin of the React app, for CORS
CLIENT_ORIGIN=http://localhost:5173

# Used only by `npm test`. Must point at a throwaway database: tests create and clear tables.
# If unset, the tests start a temporary embedded PostgreSQL instead.
TEST_DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety_test
